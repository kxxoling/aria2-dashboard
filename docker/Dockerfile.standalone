# All-in-one image: the dashboard, nginx and an aria2 daemon in a single
# container. Run it, open the port, done — the browser talks to aria2 through
# a same-origin reverse proxy, so no RPC URL or port configuration is needed.
#
# Build: docker build -f docker/Dockerfile.standalone -t aria2-dashboard-standalone .
# Run:   docker run -d -p 8080:80 -v downloads:/data aria2-dashboard-standalone

# Build stage
FROM oven/bun:1 AS builder
WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .

# Runtime-substituted placeholders (see standalone-entrypoint.sh)
ENV VITE_ARIA2_RPC_URL=__RPC_URL_PLACEHOLDER__
ENV VITE_ARIA2_RPC_SECRET=__RPC_SECRET_PLACEHOLDER__
RUN bunx vite build

# Runtime stage: nginx + aria2
FROM nginx:alpine

RUN apk add --no-cache aria2 apache2-utils curl

COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx.standalone.conf /etc/nginx/conf.d/default.conf
COPY docker/standalone-entrypoint.sh /standalone-entrypoint.sh
RUN chmod +x /standalone-entrypoint.sh

VOLUME /data
# 80 = web UI / RPC proxy; 6881-6999 = BitTorrent + DHT (map them for
# inbound peers — without mapping, downloads rely on outbound connections
# only and BT speeds suffer behind NAT)
EXPOSE 80 6881-6999

ENTRYPOINT ["/standalone-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
