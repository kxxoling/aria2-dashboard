# Aria2 RPC endpoint used as the default in the web app.
# The connection can also be changed at runtime from the Settings page.
VITE_ARIA2_RPC_URL=ws://localhost:6800/jsonrpc

# Aria2 RPC secret (optional)
VITE_ARIA2_RPC_SECRET=

# Enable mock mode for development without a real Aria2 instance
VITE_USE_MOCK=false
